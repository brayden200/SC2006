PORT=3000
WEB_ORIGIN=http://localhost:5173

# LTA DataMall AccountKey. Sent only from the NestJS backend.
LTA_ACCOUNT_KEY=

# A current OneMap access token (valid for three days). If it returns 401 and
# the credentials below are set, the backend refreshes a token automatically.
ONEMAP_TOKEN=

# Optional alternative: let the backend generate and refresh the OneMap token.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

LTA_DATAMALL_BASE_URL=https://datamall2.mytransport.sg/ltaodataservice
ONEMAP_BASE_URL=https://www.onemap.gov.sg
VITE_API_URL=http://localhost:3000/api

# Optional URA daily car-park details credentials. Backend only; never expose in Vite.
URA_ACCESS_KEY=
URA_TOKEN=
URA_BASE_URL=https://eservice.ura.gov.sg/uraDataService
